# ---------------------------------------------------------------------------
# KYN — Vercel environment variables
# Set these in Vercel > Project > Settings > Environment Variables, then REDEPLOY.
# Nothing here belongs in GitHub. Do not commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# KYN's own Meta dataset. NOT Heavelyn's (1341069530921816).
META_PIXEL_ID=1627686942360128

# Events Manager > dataset > Settings > Conversions API > Generate access token.
# Secret. Shown once.
META_ACCESS_TOKEN=

# Graph API version. The code falls back to v21.0, which is roughly two years
# old and close to Meta's retirement window — pin a current one explicitly.
META_API_VERSION=v25.0

# Test Events tab > test event code. Set while verifying, REMOVE for production
# (events sent with a test code are excluded from optimisation and reporting).
META_TEST_EVENT_CODE=

# Filled in at the end, once the orders/paid webhook exists and Shopify shows
# you its signing secret. Until this is set, the webhook returns 401 by design.
SHOPIFY_WEBHOOK_SECRET=
